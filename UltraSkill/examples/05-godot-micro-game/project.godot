; Engine configuration file.
; UltraSkill Example 05 — Iron Bastion Micro-Arena (Godot 4.3, LOW Preset Baseline)

config_version=5

[application]

config/name="Iron Bastion — UltraSkill Example 05"
config/version="1.0.0"
run/main_scene="res://arena_main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/game.log"
file_logging/max_log_files=5
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="WorldStatic"
3d_physics/layer_2="WorldDynamic"
3d_physics/layer_3="PlayerBody"
3d_physics/layer_4="EnemyBody"
3d_physics/layer_5="PlayerHurtbox"
3d_physics/layer_6="EnemyHurtbox"
3d_physics/layer_7="PlayerHitbox"
3d_physics/layer_8="EnemyHitbox"
3d_physics/layer_9="Projectiles"
3d_physics/layer_10="Interactables"
3d_physics/layer_11="Triggers"
3d_physics/layer_12="CameraOccluder"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=1024
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/screen_space_aa=1
